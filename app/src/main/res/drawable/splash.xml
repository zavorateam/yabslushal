<?xml version="1.0" encoding="utf-8"?>
<!-- Splash mark: the Yabslushal Y, with the four waveform bars bouncing in place.
	Each bar animates its own translateY and returns to zero, so the bounce ends
	exactly where the static launcher mark sits and leaves no visible jump. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
	android:drawable="@drawable/splash_mark">
	<!-- Outer bars: short hop -->
	<target
		android:name="bar_outer_left"
		android:animation="@animator/splash_bounce_1" />
	<target
		android:name="bar_outer_right"
		android:animation="@animator/splash_bounce_1" />
	<!-- Inner bars: taller hop, so the group never moves as one block -->
	<target
		android:name="bar_inner_left"
		android:animation="@animator/splash_bounce_2" />
	<target
		android:name="bar_inner_right"
		android:animation="@animator/splash_bounce_2" />
</animated-vector>
